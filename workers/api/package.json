{
  "name": "@goldstein/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "goldstein-api Worker: tonight's playlists. Hourly cron generates editions into KV; serves /playlists/{index,tonight,history}.json and editions/<id>.json. ./proxy is the Worker each site uses (service binding).",
  "exports": {
    ".": "./src/index.ts",
    "./proxy": "./src/proxy.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "npm run ensure -w @goldstein/data && wrangler dev --port 8787 --test-scheduled",
    "build": "wrangler deploy --dry-run --env= --outdir dist",
    "deploy": "wrangler deploy --env=",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@goldstein/data": "0.0.0",
    "@goldstein/playlists": "0.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@goldstein/config": "0.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.2",
    "wrangler": "4.156.0"
  }
}
