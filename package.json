{
  "name": "rabbigoldsteinstories",
  "private": true,
  "type": "module",
  "description": "Rabbi Goldstein Stories: archive data (data/) plus the bedtime, kids and library websites and a landing page. See docs/ARCHITECTURE.md.",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/config",
    "packages/data",
    "packages/playlists",
    "packages/player",
    "workers/api",
    "apps/bedtime",
    "apps/kids",
    "apps/library",
    "apps/home"
  ],
  "scripts": {
    "data:build": "npm run build -w @goldstein/data",
    "data:ensure": "npm run ensure -w @goldstein/data",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run data:ensure && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "privacy:gate": "npm run gate -w @goldstein/data --",
    "format": "prettier --write \"apps/**/*.{ts,astro,css,json,jsonc}\" \"packages/**/*.{ts,json}\" \"workers/**/*.{ts,json,jsonc}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,astro,css,json,jsonc}\" \"packages/**/*.{ts,json}\" \"workers/**/*.{ts,json,jsonc}\"",
    "dev:api": "npm run dev -w @goldstein/api",
    "dev:bedtime": "npm run dev -w @goldstein/bedtime",
    "dev:kids": "npm run dev -w @goldstein/kids",
    "dev:library": "npm run dev -w @goldstein/library",
    "dev:home": "npm run dev -w @goldstein/home",
    "playlists:preview": "npm run data:ensure && npm run preview -w @goldstein/playlists --"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
