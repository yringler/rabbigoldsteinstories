---
// /serial/<key> (§4.4): chapters in order, story-only playback (default), missing chapters, other runs.
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import { getModel } from "../../../lib/build/model.ts";
import { serialPlan, serialSeconds, serialVis } from "../../../lib/build/views.ts";
import { VARIANTS, minutes } from "../../../lib/kinds.ts";
import { itemPath } from "../../../lib/records.ts";
import { ui } from "../../../lib/ui-icons.ts";
import { notYi } from "../../../lib/build/lang.ts";
import LangPanel from "../../../components/LangPanel.astro";

export const getStaticPaths = (() =>
  getModel()
    .serials.filter((s) => s.chapters.some((c) => c.id))
    .map((s) => ({ params: { key: s.key } }))) satisfies GetStaticPaths;

const m = getModel();
const s = m.serialByKey.get(String(Astro.params.key));
if (!s) throw new Error("unknown serial");
const present = s.chapters.filter((c): c is typeof c & { id: string } => c.id !== null);
const isRadio = s.type === "radio";
// Chapters are keyed by position (one recording can hold two chapters), never by recording id.
const data = {
  title: s.title,
  ids: present.map((c) => c.id),
  story: serialPlan(s, true, m),
  whole: serialPlan(s, false, m),
};
const vis = serialVis(s, m);
const word = isRadio ? "Chapter" : "Part";
const durOf = (id: string, i: number) => {
  const c = present[i];
  const k = m.items.get(id);
  if (!c || !k) return 0;
  return c.story.length ? c.story.reduce((a, r) => a + r.end_sec - r.start_sec, 0) : k.dur;
};
---

<Base
  title={s.title}
  tab="explore"
  description={`${s.title}: a story in ${s.chapters.length} chapters.`}
>
  <LangPanel title="Chapter stories are in English." />
  <div data-init="serial" class="serial-page" data-vis={notYi().join(" ")}>
    <script
      is:inline
      type="application/json"
      data-serial-data
      set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
    />
    <header class="serial-head">
      <img
        src={`/covers/serial/${s.key}.svg`}
        alt=""
        width="240"
        height="240"
        class="serial-cover"
      />
      <div>
        <p class="serial-kicker">
          {isRadio ? "Chapter story from the radio show" : "A story in parts"}
        </p>
        <h1>{s.title}</h1>
        <p class="muted serial-meta">
          {s.chapters.length} {isRadio ? "chapters" : "parts"} · {minutes(serialSeconds(s, m))}
        </p>
        <div class="banner" data-vis={VARIANTS.filter((v) => !vis.includes(v)).join(" ")}>
          <Fragment set:html={ui("info", "", 28)} />
          <span>This one is for bigger kids.</span>
        </div>
        <button type="button" class="btn primary big" data-ch-main data-pos="0">
          <Fragment set:html={ui("play", "", 30)} />
          <span data-ch-main-label>Play from {word} 1</span>
        </button>
        {isRadio && (
          <label class="switch">
            <input type="checkbox" data-story-only checked />
            <span class="switch-ui" aria-hidden="true" />
            <span>
              Just the story <small>(turn off to play the whole radio show)</small>
            </span>
          </label>
        )}
      </div>
    </header>

    <ol class="ch-list">
      {s.chapters.map((c) => {
        if (!c.id)
          return (
            <li class="ch-row missing">
              <span class="ch-num">{c.n}</span>
              <span class="ch-t">
                {word} {c.n}: we're still looking for this one
              </span>
            </li>
          );
        const pos = present.findIndex((p) => p.n === c.n);
        return (
          <li class="ch-row" data-ch-id={c.id}>
            <button
              type="button"
              class="ch-play"
              data-ch-pos={String(pos)}
              data-n={String(c.n)}
              aria-label={`Play ${word} ${c.n}`}
            >
              <span class="ch-num">{c.n}</span>
            </button>
            <a class="ch-t" href={itemPath(c.id)}>
              <span class="ch-title">{c.title}</span>
              <span class="ch-dur">{minutes(durOf(c.id, pos))}</span>
            </a>
            <span class="ch-tick" aria-hidden="true">
              <Fragment set:html={ui("check", "", 22)} />
            </span>
            <span class="sr ch-done-sr">Finished</span>
          </li>
        );
      })}
    </ol>

    {s.otherRuns.length > 0 && (
      <details class="others">
        <summary>
          Other times Uncle Yossi told this story
          <Fragment set:html={ui("down", "chev", 24)} />
        </summary>
        <ul>
          {s.otherRuns.map((r) => (
            <li>
              <b>{r.label}:</b>{" "}
              {r.chapters.map((c, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={itemPath(c.id)}>Chapter {c.n}</a>
                </>
              ))}
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>
</Base>

<style is:global>
  .serial-head {
    display: grid;
    gap: 16px;
    margin: 12px 0 20px;
  }
  @media (min-width: 720px) {
    .serial-head {
      grid-template-columns: 240px 1fr;
      align-items: center;
      gap: 28px;
    }
  }
  .serial-cover {
    width: min(240px, 60vw);
    height: auto;
    border-radius: 26px;
    border: 3px solid var(--ink);
    box-shadow:
      8px 8px 0 -3px var(--paper),
      8px 8px 0 0 var(--ink),
      0 6px 0 var(--ink);
    justify-self: center;
  }
  .serial-kicker {
    font-weight: 700;
    color: var(--grape);
  }
  .serial-meta {
    margin: 4px 0 14px;
    font-weight: 700;
  }
  .ch-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .ch-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px 6px 6px;
    border-radius: 20px;
    background: var(--card);
    border: 2px solid var(--line);
    min-height: 72px;
  }
  .ch-play {
    flex: none;
    width: 60px;
    height: 60px;
    border-radius: 16px;
    border: 2px solid var(--ink);
    background: var(--sun);
    box-shadow: 0 3px 0 var(--ink);
  }
  .ch-num {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 28px;
  }
  .ch-row.missing {
    background: transparent;
    border-style: dashed;
    color: var(--ink-soft);
  }
  .ch-row.missing .ch-num {
    width: 60px;
    text-align: center;
    color: #b9ab92;
  }
  .ch-t {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--ink);
    text-decoration: none;
  }
  .ch-title {
    font-weight: 700;
  }
  .ch-dur {
    font-size: 15px;
    color: var(--ink-soft);
  }
  .ch-tick {
    display: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--leaf);
    color: #fff;
    place-items: center;
  }
  .ch-done-sr {
    display: none;
  }
  .ch-row.done .ch-tick {
    display: grid;
  }
  .ch-row.done .ch-play {
    background: #d8f0e4;
  }
</style>
