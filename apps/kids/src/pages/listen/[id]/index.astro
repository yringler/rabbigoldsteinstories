---
// Item page (docs/sites/kids.md §6): one per kid-pool item, plus superseded copies ("Other versions").
// The kids' site never renders transcripts; private segment types show generic labels only.
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import { SITES, itemUrl, siteUrl } from "@goldstein/config/sites";
import { getModel, capPerVariant, type KItem } from "../../../lib/build/model.ts";
import { card, trackOf, playAttr } from "../../../lib/build/views.ts";
import { KIND_LABEL, clock, minutes } from "../../../lib/kinds.ts";
import { coverPath, itemPath } from "../../../lib/records.ts";
import {
  HOLIDAY_TILES,
  MIDOS_TILES,
  MITZVOS_TILES,
  TOPIC_TILES,
  tilePath,
} from "../../../lib/tiles.ts";
import { ui } from "../../../lib/ui-icons.ts";
import { iconSvg } from "../../../lib/icons.ts";
import type { PlayRequest } from "../../../lib/tracks.ts";

export const getStaticPaths = (() =>
  [...getModel().items.keys()].map((id) => ({ params: { id } }))) satisfies GetStaticPaths;

const m = getModel();
const id = String(Astro.params.id);
const k = m.items.get(id) as KItem;
const it = k.item;
const track = trackOf(k);
const single: PlayRequest = { tracks: [track], mode: "single" };
const showJump = k.kind === "show" && k.jump !== null && k.jump > it.content_start_sec + 5;

// Tags: hero tiles first, then midos, holiday, topic (max 8), only tiles that exist on this site.
const heroTiles = m.tiles.heroes.filter((h) => k.heroes.includes(h.slug));
const pick = <T extends { ids: readonly string[] }>(tiles: readonly T[], ids: readonly string[]) =>
  tiles.filter((t) => t.ids.some((x) => ids.includes(x)));
const tags = [
  ...heroTiles.map((t) => ({ label: t.label, href: tilePath(t), icon: t.icon })),
  ...pick(MIDOS_TILES, it.subjects.midos).map((t) => ({
    label: t.label,
    href: tilePath(t),
    icon: t.icon,
  })),
  ...pick(HOLIDAY_TILES, it.subjects.calendar).map((t) => ({
    label: t.label,
    href: tilePath(t),
    icon: t.icon,
  })),
  ...pick(TOPIC_TILES, it.subjects.topics).map((t) => ({
    label: t.label,
    href: tilePath(t),
    icon: t.icon,
  })),
  ...pick(MITZVOS_TILES, it.subjects.mitzvos).map((t) => ({
    label: t.label,
    href: tilePath(t),
    icon: t.icon,
  })),
].slice(0, 8);
const characters = it.subjects.characters.slice(0, 8);

// Relations.
const clip = it.relations.find((r) => r.type === "clip_of" && m.items.has(r.target_id));
const parent = clip ? m.items.get(clip.target_id) : undefined;
const parentReq: PlayRequest | null = parent
  ? {
      tracks: [trackOf(parent)],
      mode: "single",
      at: clip?.offset_sec ?? parent.item.content_start_sec,
    }
  : null;
const ch = m.chapterOf.get(id);
const chWord = ch?.type === "set" ? "Part" : "Chapter";
const chLabel = ch
  ? ch.ns.length > 1
    ? `${chWord}s ${ch.ns.join(" and ")} of ${ch.of}`
    : `${chWord} ${ch.n} of ${ch.of}`
  : "";
const others = (m.otherVersions.get(id) ?? [])
  .map((x) => m.items.get(x))
  .filter((x): x is KItem => Boolean(x));
const group = m.storyGroupOf.get(id);
const tellings = (group?.others ?? [])
  .map((x) => m.items.get(x))
  .filter((x): x is KItem => Boolean(x) && (x as KItem).inPool);
const related = capPerVariant(
  (m.sim.related.get(id) ?? []).map((x) => m.items.get(x)).filter((x): x is KItem => Boolean(x)),
  6,
);
const preferred = it.derived.preferred_ids
  .map((x) => m.items.get(x))
  .filter((x): x is KItem => Boolean(x));

// For grown-ups.
const advisories = it.audience.advisories.map((a) => ({
  label: m.vocab("content_advisory", a.flag)?.label ?? a.flag,
  severity: a.severity,
  note: a.note,
}));
const moderate = it.audience.advisories.some((a) => a.severity === "moderate");
function fmtDate(): string | null {
  const d = it.classification.date;
  if (!d || d.precision === "unknown" || d.precision === "decade") return null;
  const g = d.gregorian ?? "";
  const parts = g.split("-").map(Number);
  const months = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
  ];
  let greg = "";
  if (parts.length === 3 && (d.precision === "day" || d.precision === "week"))
    greg = `${d.precision === "week" ? "the week of " : ""}${parts[2]} ${months[(parts[1] ?? 1) - 1]} ${parts[0]}`;
  else if (parts.length >= 2 && d.precision !== "year")
    greg = `${months[(parts[1] ?? 1) - 1]} ${parts[0]}`;
  else if (parts[0]) greg = String(parts[0]);
  const heb = d.precision === "day" && d.hebrew ? ` (${d.hebrew})` : "";
  return greg ? `${greg}${heb}` : null;
}
const aired = fmtDate();
const libraryUrl = itemUrl("library", id);
const contentEndsEarly = it.content_end_sec < it.duration_sec - 1;
---

<Base title={k.title} description={it.summary_short}>
  <article
    class="item"
    data-init="listen"
    data-age={k.age}
    data-adv={k.adv}
    data-pool={k.inPool ? "1" : undefined}
  >
    <div class="banner" data-band-banner hidden>
      <Fragment set:html={ui("info", "", 28)} />
      <span data-band-text>This one is for bigger kids.</span>
    </div>
    {!k.inPool && preferred[0] && (
      <div class="banner">
        <Fragment set:html={ui("info", "", 28)} />
        <span>
          This is another copy of <a href={itemPath(preferred[0].id)}>{preferred[0].title}</a>.
        </span>
      </div>
    )}

    <header class="item-head">
      <img class="item-cover" src={coverPath(id)} alt="" width="320" height="320" />
      <div class="item-title">
        <h1 title={k.title}>{k.title}</h1>
        {k.byline && <p class="byline">Told by {k.byline}</p>}
        <ul class="pills" aria-label="About this recording">
          <li>{minutes(k.dur)}</li>
          <li>Ages {k.age}+</li>
          <li>{KIND_LABEL[k.kind]}</li>
          {ch && <li>{chLabel}</li>}
        </ul>
        <div class="play-row">
          <button
            type="button"
            class="btn primary play-xl"
            data-play={playAttr(single)}
            aria-label={`Play ${k.title}`}
          >
            <Fragment set:html={ui("play", "", 42)} />
          </button>
          {showJump && (
            <button
              type="button"
              class="btn sun big jump"
              data-seek={String(k.jump)}
              data-seek-id={id}
              data-seek-play={playAttr(single)}
            >
              <Fragment set:html={ui("story-jump", "", 30)} />
              Jump to the story
            </button>
          )}
        </div>
        <div class="actions">
          {
            // Hearts list only kid-pool items, so a superseded copy offers none (§4.8).
            k.inPool && (
              <button type="button" class="act" data-fav={id} aria-pressed="false">
                <span class="h-off">
                  <Fragment set:html={ui("heart", "", 28)} />
                </span>
                <span class="h-on">
                  <Fragment set:html={ui("heart-fill", "", 28)} />
                </span>
                <span>Heart</span>
              </button>
            )
          }
          <button type="button" class="act" data-play-next={JSON.stringify(track)}>
            <Fragment set:html={ui("play-next", "", 28)} />
            <span>Play next</span>
          </button>
          <button type="button" class="act" data-share hidden>
            <Fragment set:html={ui("share", "", 28)} />
            <span>Share</span>
          </button>
        </div>
      </div>
    </header>

    <div class="item-body">
      <div class="item-main">
        <section class="about" aria-labelledby="about-h">
          <h2 id="about-h">What it's about</h2>
          <p>{it.summary_short}</p>
        </section>
        {it.lesson && (
          <section class="lesson" aria-labelledby="lesson-h">
            <span class="lesson-ic">
              <Fragment set:html={ui("bulb", "", 30)} />
            </span>
            <div>
              <h2 id="lesson-h">What we learn</h2>
              <p>{it.lesson}</p>
            </div>
          </section>
        )}

        {ch && (
          <nav class="ch-strip" aria-label="Chapters">
            {ch.prev ? (
              <a class="icon-btn" href={itemPath(ch.prev)} aria-label="Previous chapter">
                <Fragment set:html={ui("back", "", 28)} />
              </a>
            ) : (
              <span class="icon-btn" aria-hidden="true" />
            )}
            <a class="ch-mid" href={`/serial/${ch.serialKey}/`}>
              <b>{chLabel}</b>
              <span>{ch.serialTitle}</span>
            </a>
            {ch.next ? (
              <a class="icon-btn" href={itemPath(ch.next)} aria-label="Next chapter">
                <Fragment set:html={ui("right", "", 28)} />
              </a>
            ) : (
              <span class="icon-btn" aria-hidden="true" />
            )}
          </nav>
        )}

        {parent && parentReq && (
          <section class="rel-card">
            <img src={coverPath(parent.id)} alt="" width="72" height="72" />
            <div>
              <p class="rel-k">
                This is a piece of
                {parent.item.classification.episode
                  ? ` Episode ${parent.item.classification.episode.number}`
                  : " a radio show"}
              </p>
              <a href={itemPath(parent.id)}>{parent.title}</a>
            </div>
            <button type="button" class="btn sun" data-play={playAttr(parentReq)}>
              <Fragment set:html={ui("play", "", 24)} />
              Play it there
            </button>
          </section>
        )}

        {k.chapters.length > 0 && (
          <section class="chapters" aria-labelledby="ch-h">
            <h2 id="ch-h">Chapters</h2>
            <ol>
              {k.chapters.map((c) => (
                <li class={`chr chr-${c.style}`}>
                  <button
                    type="button"
                    data-seek={String(c.s)}
                    data-seek-id={id}
                    data-seek-play={playAttr(single)}
                  >
                    <span class="chr-ic">
                      <Fragment
                        set:html={iconSvg(
                          c.icon,
                          { accent: c.style === "story" ? "#FFC83D" : "#E7DCC8" },
                          30,
                        )}
                      />
                    </span>
                    <span class="chr-text">
                      <span class="chr-label">{c.label}</span>
                      {c.summary && (c.style === "story" || c.style === "talk") && (
                        <span class="chr-sum">{c.summary}</span>
                      )}
                    </span>
                    <span class="chr-time">{clock(c.s)}</span>
                  </button>
                </li>
              ))}
            </ol>
            {contentEndsEarly && (
              <p class="muted small">The story ends at {clock(it.content_end_sec)}.</p>
            )}
          </section>
        )}

        {(tags.length > 0 || characters.length > 0) && (
          <section class="tags" aria-labelledby="tags-h">
            <h2 id="tags-h" class="sr">
              Tags
            </h2>
            {tags.length > 0 && (
              <div class="tag-chips">
                {tags.map((t) => (
                  <a class="chip tag-chip" href={t.href}>
                    <Fragment set:html={iconSvg(t.icon, { accent: "#FFC83D" }, 28)} />
                    {t.label}
                  </a>
                ))}
              </div>
            )}
            {characters.length > 0 && (
              <>
                <h3 class="who">Who's in this story</h3>
                <ul class="char-chips">
                  {characters.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}

        {tellings.length > 0 && (
          <section class="section" aria-labelledby="tell-h">
            <h2 id="tell-h">Hear this story told another way</h2>
            <div class="shelf-row" set:html={tellings.map((t) => card(t)).join("")} />
          </section>
        )}
        {group?.yiddish && libraryUrl && (
          <p class="muted">
            Also told in Yiddish in the <a href={siteUrl("library", "/")}>grown-ups' library</a>.
          </p>
        )}

        {related.length > 0 && (
          <section class="section" aria-labelledby="more-h">
            <h2 id="more-h">More like this</h2>
            <div
              class="grid more-like"
              set:html={related.map(({ k: r, vis }) => card(r, { vis })).join("")}
            />
          </section>
        )}

        {others.length > 0 && (
          <details class="others">
            <summary>
              Other versions ({others.length})
              <Fragment set:html={ui("down", "chev", 24)} />
            </summary>
            <ul>
              {others.map((o) => (
                <li>
                  <a href={itemPath(o.id)}>{o.title}</a>{" "}
                  <span class="muted">· {minutes(o.dur)}</span>
                </li>
              ))}
            </ul>
          </details>
        )}

        <details class="grownups" open={moderate}>
          <summary>
            <Fragment set:html={ui("grownups", "", 26)} />
            For grown-ups
            <Fragment set:html={ui("down", "chev", 24)} />
          </summary>
          <div class="gu-body">
            {advisories.length > 0 ? (
              <ul class="advisories">
                {advisories.map((a) => (
                  <li class={`adv-${a.severity}`}>
                    <b>{a.label}</b> <span class="sev">({a.severity})</span>: {a.note}
                  </li>
                ))}
              </ul>
            ) : (
              <p>No content notes for this one.</p>
            )}
            <p>{it.summary_long}</p>
            {aired && <p class="muted">First aired or recorded: {aired}.</p>}
            <p class="muted">
              Summaries and notes were written with the help of AI and may contain mistakes. The
              recording is the original, unedited.
            </p>
            {libraryUrl && (
              <p>
                <a href={libraryUrl}>
                  Read the automatic transcript in the grown-ups' library ({SITES.library.name})
                </a>
              </p>
            )}
          </div>
        </details>
      </div>
    </div>
  </article>
</Base>

<style is:global>
  .item-head {
    display: grid;
    gap: 18px;
    margin: 12px 0 8px;
  }
  @media (min-width: 720px) {
    .item-head {
      grid-template-columns: 300px 1fr;
      align-items: center;
      gap: 32px;
    }
  }
  .item-cover {
    width: min(300px, 70vw);
    height: auto;
    aspect-ratio: 1;
    border-radius: 28px;
    border: 3px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
    justify-self: center;
  }
  .item-title h1 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .byline {
    margin-top: 4px;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .pills {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pills li {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--card);
    border: 2px solid var(--line);
    font-weight: 700;
    font-size: 16px;
  }
  .play-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin: 18px 0 8px;
  }
  .actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .act {
    min-height: 56px;
    min-width: 56px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px 0 12px;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    font-weight: 700;
    color: var(--ink);
  }
  .act[hidden] {
    display: none;
  }
  .act .h-on {
    display: none;
    color: var(--coral);
  }
  .act[aria-pressed="true"] {
    border-color: var(--coral);
    background: #fff0ed;
  }
  .act[aria-pressed="true"] .h-on {
    display: block;
  }
  .act[aria-pressed="true"] .h-off {
    display: none;
  }
  .wobble svg {
    animation: wobble 0.45s ease;
  }
  @keyframes wobble {
    25% {
      transform: rotate(-14deg) scale(1.15);
    }
    60% {
      transform: rotate(10deg) scale(1.1);
    }
  }
  .about,
  .lesson {
    margin-top: 22px;
  }
  .about h2,
  .lesson h2,
  .chapters h2 {
    font-size: 23px;
    margin-bottom: 6px;
  }
  .lesson {
    display: flex;
    gap: 14px;
    padding: 16px;
    border-radius: 22px;
    background: #fff3cf;
    border: 2px solid #f1d98a;
  }
  .lesson-ic {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--sun);
    display: grid;
    place-items: center;
    border: 2px solid var(--ink);
  }
  .ch-strip {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 22px;
    background: var(--card);
    border: 2px solid var(--line);
  }
  .ch-mid {
    flex: 1;
    min-height: 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
  }
  .ch-mid span {
    color: var(--primary);
    font-weight: 700;
  }
  .rel-card {
    margin-top: 22px;
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 6px 14px;
    align-items: center;
    padding: 12px;
    border-radius: 22px;
    background: var(--card);
    border: 2px solid var(--line);
  }
  .rel-card img {
    border-radius: 16px;
  }
  .rel-card .btn {
    grid-column: 1 / -1;
    justify-self: start;
  }
  .rel-k {
    font-weight: 700;
    color: var(--ink-soft);
    font-size: 16px;
  }
  .rel-card a {
    font-weight: 700;
  }
  .chapters {
    margin-top: 26px;
  }
  .chapters ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .chr button {
    width: 100%;
    min-height: 60px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px 8px 8px;
    border-radius: 18px;
    border: 2px solid var(--line);
    background: var(--card);
    text-align: left;
    color: var(--ink);
  }
  .chr button:hover {
    border-color: var(--primary);
  }
  .chr-ic {
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--paper);
  }
  .chr-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .chr-label {
    font-weight: 700;
  }
  .chr-sum {
    font-size: 16px;
    color: var(--ink-soft);
  }
  .chr-time {
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    font-weight: 700;
    font-size: 15px;
  }
  .chr-story button {
    background: #fff6dc;
    border-color: #f1d98a;
  }
  .chr-story .chr-ic {
    background: #fff;
  }
  .chr-minor button {
    min-height: 56px;
    background: transparent;
    border-style: dashed;
    color: var(--ink-soft);
  }
  .chr-minor .chr-label {
    font-weight: 400;
  }
  .small {
    font-size: 16px;
    margin-top: 6px;
  }
  .tags {
    margin-top: 26px;
  }
  .tag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag-chip {
    padding-left: 10px;
  }
  .who {
    font-size: 19px;
    margin: 18px 0 8px;
  }
  .char-chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .char-chips li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 16px;
    font-weight: 700;
  }
  .more-like {
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
  }
  .gu-body {
    padding: 0 16px 16px;
    display: grid;
    gap: 10px;
  }
  .gu-body a {
    display: inline-flex;
    min-height: 56px;
    align-items: center;
    font-weight: 700;
  }
  .advisories {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 6px;
  }
  .adv-moderate .sev {
    color: var(--coral-ink);
    font-weight: 700;
  }
</style>
