---
import Base from "../layouts/Base.astro";
import { iconSvg } from "../lib/icons.ts";
---

<Base title="Not found">
  <div class="empty" style="padding-top:48px">
    <Fragment set:html={iconSvg("hill-path", { accent: "#FFC83D" }, 120)} />
    <h1>Oops! This page wandered off.</h1>
    <p style="margin:10px 0 20px">Let's find you a story instead.</p>
    <p>
      <a class="btn primary big" href="/">
        Back home
      </a>
    </p>
  </div>
</Base>
