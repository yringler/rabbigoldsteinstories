---
/** Places index: one page, alphabetical, with counts. No map in the MVP. */
import LangNote from "../../components/LangNote.astro";
import Base from "../../layouts/Base.astro";
import { langHas, scopeInfo } from "../../lib/lang.ts";
import { rows, usageLangs } from "../../lib/site-data.ts";

const counts = new Map<string, number>();
for (const r of rows())
  if (r.preferred) for (const p of r.places) counts.set(p, (counts.get(p) ?? 0) + 1);
const places = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const letters = [...new Set(places.map(([p]) => p[0]?.toUpperCase() ?? ""))];
const top = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
const langs = usageLangs("places");
const has = (p: string) => langs.get(p) ?? [];
const info = scopeInfo(places.map(([p]) => has(p)));
const inLetter = (l: string) => places.filter(([p]) => p[0]?.toUpperCase() === l);
---

<Base
  title="Places"
  description="Towns, cities and countries in the stories, with the number of recordings for each."
>
  <div class="wrap page" data-lang-scope data-lang-empty={info.emptyAttr || undefined}>
    <header class="page-head">
      <h1>Places</h1>
      <p>
        {places.length} place names on {rows().filter((r) => r.preferred && r.places.length).length}{" "}
        recordings. Most often:
        {top.map(([p, n], i) => (
          <>
            {i > 0 && ", "}
            <a href={`/search/?places=${encodeURIComponent(p)}`}>{p}</a> ({n})
          </>
        ))}
        .
      </p>
    </header>
    <LangNote info={info} noun={{ one: "place", many: "places", terms: true }} />
    <nav class="letter-nav" aria-label="Jump to letter">
      {letters.map((l) => (
        <a href={`#l-${l}`} data-lang-has={langHas(inLetter(l).flatMap(([p]) => has(p)))}>
          {l}
        </a>
      ))}
    </nav>
    <div class="index-grid">
      {letters.map((l) => (
        <section id={`l-${l}`} data-lang-has={langHas(inLetter(l).flatMap(([p]) => has(p)))}>
          <h2 class="letter">{l}</h2>
          <ul class="index-list">
            {inLetter(l).map(([p, n]) => (
              <li data-lang-has={langHas(has(p))}>
                <a href={`/search/?places=${encodeURIComponent(p)}`}>{p}</a>
                <span class="n">{n}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .letter {
    font-size: 18px;
    color: var(--accent-2);
    margin: 0 0 4px;
  }
</style>
