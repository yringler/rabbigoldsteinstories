---
/**
 * User playlists (library.md §8), kept in this browser. /playlists/* belongs to the shared playlist
 * API on every site (docs/ARCHITECTURE.md §8), so the library's own playlists live at /my-playlists/.
 * `?id=<id>` opens one playlist; `#p=<data>` shows a shared playlist read-only.
 */
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";
---

<Base
  title="My playlists"
  description="Playlists you make from the archive, saved in this browser, with file export and import."
>
  <div class="wrap page" data-my-playlists>
    <header class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb" data-pl-crumbs hidden>
        <a href="/my-playlists/">My playlists</a>
      </nav>
      <h1 data-pl-h1>My playlists</h1>
    </header>
    <div class="notice browser-only" role="note">
      <Icon name="info" />
      <p>
        <strong>Your playlists are saved in this browser only.</strong> There are no accounts.
        Clearing browser data, private windows or another device will not have them. Export a file
        to back up or share.
      </p>
    </div>
    <div class="notice" data-pl-backup hidden></div>
    <div data-pl-messages aria-live="polite"></div>
    <div data-pl-root>
      <p class="muted">Loading…</p>
    </div>
    <noscript>
      <p class="notice">Playlists need JavaScript.</p>
    </noscript>
    <section class="print-sheet" data-print-sheet aria-hidden="true"></section>

    <dialog id="conflict-dialog" aria-labelledby="conflict-title">
      <div class="dialog-head">
        <h2 id="conflict-title">Playlist already here</h2>
      </div>
      <div class="dialog-body">
        <p data-conflict-text></p>
      </div>
      <div class="dialog-foot">
        <button type="button" class="btn" value="skip" data-conflict="skip">
          Skip
        </button>
        <button type="button" class="btn" value="keep-both" data-conflict="keep-both">
          Keep both
        </button>
        <button type="button" class="btn btn-primary" value="replace" data-conflict="replace">
          Replace
        </button>
      </div>
    </dialog>
  </div>
</Base>

<style is:global>
  .browser-only {
    margin-bottom: 16px;
    max-width: 860px;
  }
  .pl-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin: 0 0 18px;
  }
  .dropzone {
    border: 1.5px dashed var(--rule-strong);
    border-radius: 6px;
    padding: 18px;
    text-align: center;
    color: var(--muted);
    margin: 16px 0;
  }
  .dropzone.over {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .pl-table td:first-child {
    width: 45%;
  }
  .pl-items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .pl-item {
    display: grid;
    grid-template-columns: 28px 36px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: start;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }
  .pl-item.dragging {
    opacity: 0.5;
  }
  .pl-item.drop-before {
    box-shadow: inset 0 2px 0 var(--accent);
  }
  .pl-item .handle {
    cursor: grab;
    color: var(--muted);
    padding-top: 4px;
    text-align: center;
    user-select: none;
  }
  .pl-item .pos {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    padding-top: 3px;
    text-align: right;
  }
  .pl-item .what a {
    font: 600 16px/22px var(--serif);
    color: var(--ink);
    text-decoration: none;
  }
  .pl-item .what a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .pl-item .gone {
    color: var(--advisory);
    font-size: 13px;
  }
  .pl-item .acts {
    display: flex;
    gap: 2px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .pl-item textarea {
    margin-top: 6px;
    min-height: 40px;
    font-size: 13px;
  }
  .pl-head {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }
  input.pl-name {
    font: 600 24px/30px var(--serif);
    border: 1px solid transparent;
    background: transparent;
    padding: 2px 6px;
    margin-left: -7px;
    width: 100%;
    max-width: 720px;
  }
  input.pl-name:hover,
  input.pl-name:focus {
    border-color: var(--rule-strong);
    background: var(--surface);
  }
  .print-sheet {
    display: none;
  }
  @media print {
    html.print-sheet-mode .wrap > :not(.print-sheet) {
      display: none !important;
    }
    html.print-sheet-mode .print-sheet {
      display: block;
    }
    .print-sheet h1 {
      font-size: 18pt;
    }
    .print-sheet ol {
      padding: 0;
      list-style: none;
    }
    .print-sheet li {
      display: grid;
      grid-template-columns: 22px minmax(0, 1fr) 72px;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px solid #ccc;
      break-inside: avoid;
      font: 10pt/1.4 var(--sans);
    }
    .print-sheet li strong {
      font: 600 11.5pt/1.3 var(--serif);
    }
  }
</style>
