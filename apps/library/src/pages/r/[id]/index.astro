  .transcript-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 5;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
  }
  .transcript-head h2 {
    margin: 0;
  }
  .t-label {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
  }
  .t-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
    margin-left: auto;
  }
  .t-find {
    display: flex;
    gap: 4px;
    align-items: center;
  }
  .t-find input {
    width: 200px;
  }
  .t-body {
    max-width: 82ch;
    padding-top: 10px;
  }
  .t-ch {
    font: 600 13px/18px var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-2);
    margin: 22px 0 6px 64px;
  }
  .t-line,
  .t-gap {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 12px;
    margin: 0;
    padding: 4px 8px 4px 0;
    border-left: 3px solid transparent;
    font: 17px/27px var(--serif);
    cursor: pointer;
  }
  .t-line:hover {
    background: color-mix(in srgb, var(--accent-soft) 35%, transparent);
  }
  .t-line.current {
    border-left-color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-soft) 60%, transparent);
  }
  .t-line .ts,
  .t-gap .ts {
    font: 600 12px/27px var(--sans);
    text-align: right;
    text-decoration: none;
    color: var(--muted);
  }
  .t-line.current .ts {
    color: var(--accent);
  }
  .t-gap {
    font: italic 14px/22px var(--sans);
    color: var(--muted);
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .t-gap span {
    border: 1px dashed var(--rule-strong);
    padding: 4px 10px;
    border-radius: 3px;
  }
  .copy-quote {
    position: absolute;
    z-index: 20;
  }
  .print-card {
    display: none;
  }
  @media print {
    :global(html.print-card-mode) .wrap {
      display: none;
    }
    :global(html.print-card-mode) .print-card {
      display: block;
    }
    .print-card {
      border: 1.5px solid #000;
      padding: 18px 20px;
      max-width: 148mm;
      font: 10.5pt/1.45 var(--serif);
    }
    .pc-head {
      display: flex;
      justify-content: space-between;
      gap: 16px;
    }
    .pc-head h2 {
      font-size: 15pt;
      margin: 0 0 4px;
    }
    .pc-head p {
      margin: 0;
      font: 9pt/1.4 var(--sans);
    }
    .pc-sum {
      font-size: 11.5pt;
      margin-top: 10px;
    }
    .pc-cite {
      font: 8.5pt/1.4 var(--sans);
      border-top: 1px solid #999;
      padding-top: 6px;
      margin-top: 10px;
    }
    .pc-chapters {
      font: 9pt/1.4 var(--sans);
      columns: 2;
    }
    :global(html:not(.print-card-mode)) .transcript-head {
      position: static;
    }
    .rec-actions-bar,
    .t-tools,
    .ch-add {
      display: none !important;
    }
    .cols-2 {
      display: block;
    }
  }
  :global(html.card-view) .wrap {
    display: none;
  }
  :global(html.card-view) .print-card {
    display: block;
    max-width: 148mm;
    margin: 24px auto;
    background: #fff;
    color: #000;
    border: 1.5px solid #000;
    padding: 18px 20px;
    font: 15px/1.5 var(--serif);
  }
  :global(html.card-view) .pc-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
</style>
