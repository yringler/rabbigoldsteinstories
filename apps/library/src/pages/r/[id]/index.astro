      margin-bottom: 8px;
    }
  }
  .chapter-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .chapter-list li {
    padding: 6px 4px;
    border-bottom: 1px solid var(--rule);
    border-left: 3px solid transparent;
  }
  .chapter-list li.current {
    border-left-color: var(--accent-2);
    background: color-mix(in srgb, var(--accent-soft) 55%, transparent);
  }
  .ch-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    gap: 8px;
    align-items: start;
  }
  .ch-time {
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    padding-top: 1px;
  }
  .ch-title {
    line-height: 20px;
  }
  .ch-add {
    width: 28px;
    height: 28px;
  }
  .ch-more {
    margin: 2px 0 0 60px;
    font-size: 13px;
    color: var(--muted);
  }
  .ch-more summary {
    cursor: pointer;
    width: max-content;
  }
  .ch-more p {
    margin: 4px 0;
  }
  .ch-linked {
    margin: 2px 0 0 60px;
  }
  .rel-group h3 {
    font-size: 13px;
    color: var(--muted);
    margin: 14px 0 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .rel-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rel-group li {
    padding: 3px 0;
  }
  details.rel-group summary {
    cursor: pointer;
    margin-top: 14px;
    color: var(--muted);
  }
  .transcript {
    margin-top: 16px;
    border-top: 2px solid var(--ink);
