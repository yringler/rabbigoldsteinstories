---
/**
 * A vocabulary list with counts; every term links to /search with that facet set (library.md §3).
 * Under a one-language setting, terms with no recording in that language are hidden by CSS, with
 * a note (docs/design/language-library.md §4).
 */
import { langHas, scopeInfo } from "../lib/lang.ts";
import { label, unconfirmed, usage, usageLangs, vocab } from "../lib/site-data.ts";
import LangNote from "./LangNote.astro";

interface Props {
  list: "midos" | "mitzvos" | "topics";
  facet: string;
}
const { list, facet } = Astro.props;
const counts = usage(list);
const langs = usageLangs(list);
const entries = (vocab().lists[list] ?? [])
  .map((e) => ({
    id: e.id,
    label: label(list, e.id),
    n: counts.get(e.id) ?? 0,
    unconfirmed: unconfirmed(list, e.id),
    langs: langs.get(e.id) ?? [],
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
const used = entries.filter((e) => e.n > 0);
const unused = entries.filter((e) => e.n === 0);
const info = scopeInfo(used.map((e) => e.langs));
---

<div data-lang-scope data-lang-empty={info.emptyAttr || undefined}>
  <LangNote info={info} noun={{ one: "term", many: "terms", terms: true }} />
  <ul class="index-list term-cols">
    {used.map((e) => (
      <li data-lang-has={langHas(e.langs)}>
        <a href={`/search/?${facet}=${e.id}`} class={e.unconfirmed ? "unconfirmed" : undefined}>
          {e.label}
        </a>
        <span class="n">{e.n}</span>
      </li>
    ))}
  </ul>
</div>
{unused.length > 0 && (
  <p class="small muted" style="margin-top:18px">
    Not tagged on any recording yet: {unused.map((e) => e.label).join(", ")}.
  </p>
)}

<style>
  .term-cols {
    columns: 3 240px;
    column-gap: 32px;
  }
</style>
